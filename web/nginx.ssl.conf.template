limit_req_zone $binary_remote_addr zone=api:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=conn:10m;

server {
    listen 443 ssl;
    ssl_certificate /etc/nginx/certs/cert.crt;
    ssl_certificate_key /etc/nginx/certs/cert.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    server_name _;
    root /usr/share/nginx/html;

    allow ${ALLOWED_NETWORK};
    allow 127.0.0.1;
    deny all;

    add_header X-Frame-Options "DENY";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection "1; mode=block";
    add_header Strict-Transport-Security "max-age=31536000" always;

    limit_conn conn 5;

    location /auto_apms_studio/ {
        try_files $uri $uri/ /auto_apms_studio/index.html;
    }
    location = / {
        return 301 $scheme://$http_host/auto_apms_studio/;
    }
    location /api/v1/ {
        limit_req zone=api burst=5 nodelay;
        proxy_pass http://${AUTO_APMS_STUDIO_BACKEND_HOST}:${AUTO_APMS_STUDIO_BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /health {
        proxy_pass http://${AUTO_APMS_STUDIO_BACKEND_HOST}:${AUTO_APMS_STUDIO_BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /ws/v1/ {
        limit_req zone=api burst=5 nodelay;
        proxy_pass http://${AUTO_APMS_STUDIO_BACKEND_HOST}:${AUTO_APMS_STUDIO_BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

server {
    listen 80;
    return 301 https://$host$request_uri;
}
